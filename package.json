    "@deepseek-ai/dsh-user-approval": "0.2.0-rc.2",
    "@types/node": "^26.1.0",
    "esbuild": "^0.28.1",
    "pnpm": "11.22.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "tar": "7.5.22",
    "yaml": "^2.9.1",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "exports": {
    ".": "./dist/index.js",
    "./bridge": "./dist/bridge.js",
    "./server": "./dist/server.js",
    "./plugin": "./dist/plugin.js",
    "./stdio": "./dist/stdio.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshAcp": {
    "standaloneDsh": "0.2.0-rc.2",
    "hostCompatibility": {
      "cordisProtocol": 0,
      "policy": "capability-negotiated"
    }
  },
  "optionalDependencies": {
    "@deepseek-ai/libreoffice-kit-darwin-arm64": "0.1.1",
    "@deepseek-ai/libreoffice-kit-darwin-x64": "0.1.1",
    "@deepseek-ai/libreoffice-kit-wasm": "0.1.1",
